# Postgres de production. Sans DATABASE_URL, l'API garde le fichier sql.js (urgad.db).
# Sur Render le disque est éphémère : DATABASE_URL est obligatoire avant d'ouvrir au public.
DATABASE_URL=postgres://user:pass@host:5432/urgad

# Obligatoire en production (pas le secret de démo).
JWT_SECRET=

NODE_ENV=production

# 1 = charger Marie Dupont / admin123 même en prod (à éviter).
# 0 ou absent en production = pas de comptes démo.
URGAD_SEED=0

# Premier admin réel si la base est vide (mot de passe ≥ 10 caractères).
URGAD_ADMIN_EMAIL=toi@urgad.fr
URGAD_ADMIN_PASSWORD=
URGAD_ADMIN_PHONE=

# 1 = renvoyer le code SMS dans le JSON (dev seulement).
URGAD_EXPOSE_CODES=0

# Stripe Checkout (abonnements établissement). Sans clé : plan enregistré, pas de débit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_URL=https://urgad-api.onrender.com

# Push Firebase Cloud Messaging. Vide = in-app seulement.
FIREBASE_SERVICE_ACCOUNT=
