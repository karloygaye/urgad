# Postgres de production. Sans DATABASE_URL, l'API garde le fichier sql.js (urgad.db).
DATABASE_URL=postgres://user:pass@host:5432/urgad

# Prestataire de paiement. Laisser vide : l abonnement reste pending, aucun debit.
# Lue seulement dans src/billing.ts, la ou un appel reel serait branche plus tard.
STRIPE_SECRET_KEY=

# Push Firebase Cloud Messaging (API HTTP v1, via firebase-admin).
# Compte de service Firebase : le JSON complet sur une ligne, OU le chemin du fichier .json.
# Vide : les notifications restent in-app (table notifications), aucun push n'est envoyé.
FIREBASE_SERVICE_ACCOUNT=
